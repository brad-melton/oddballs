# Copy this file to .env.local and fill in real values -- .env.local is
# gitignored and never leaves this machine. Used by sync_to_turso.py (and
# fall2026catchupscoring.py, when it calls that) to push freshly-scraped
# data from this laptop into the hosted Turso database.
#
# Get a database-scoped token from the Turso dashboard -> your database ->
# Tokens (not the account-wide platform API token).
TURSO_DATABASE_URL=libsql://10u-data-brad-melton.aws-us-east-2.turso.io
TURSO_AUTH_TOKEN=
