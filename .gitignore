# Python
__pycache__/
*.pyc
.venv/
backend/.venv/

# Node
node_modules/

# Logs
*.log

# Local data / deployment artifacts -- never commit the real database or a
# WAL-mode copy of it; the deployed backend reads from Turso instead (see
# backend/db.py). Re-generate deploy/*.db locally whenever it's needed again.
deploy/
*.db
*.db-wal
*.db-shm

# Stray local binaries -- irrelevant to the Linux Docker deploy target and
# don't belong in source control regardless.
*.exe

# Local secrets -- TURSO_DATABASE_URL / TURSO_AUTH_TOKEN for running the
# scraping pipeline against the hosted DB from this laptop. Never commit
# real credentials; see .env.example for the format.
.env
.env.local

# GameChanger scraper session/login artifacts -- gc_storage_state.json is a
# live session credential, .gc_login_profile/ is a real Chrome profile
# (cookies, local storage) used only for the --login flow. See
# gamechanger_scrape.py.
gc_storage_state.json
.gc_login_profile/

# Real GameChanger data captured during development/recon -- not needed
# once its shape has been coded against, and may contain real player names.
sample boxscore.json

# Editor / OS
.vscode/
.DS_Store
Thumbs.db
